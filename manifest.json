{
  "manifest_version": 1,
  "id": "cn.ucbk.video",
  "name": "视频解析",
  "version": "1.6.1",
  "description": "视频解析作为 AI 工具提供。群里贴抖音、B站、小红书、快手、今日头条、微博、皮皮搞笑、皮皮虾、即梦或豆包的分享链接时，由 AI 调用 parse_video_link 读取标题、作者、时长、互动数据与描述卡片（含发布者写的完整原文），再按人设组织回复；视频或原图由系统紧跟回复一起发出。插件不监听消息、不抢占消息、不主动发消息，也不会在群里补直链。\n\n用法：\n1. 安装并启用本插件并批准「访问外网」能力，机器人需开启 AI 回复；\n2. 群里贴链接即可，AI 会自行判断并调用工具；运行记录的 Agent 调用步骤里能看到这次插件调用；\n3. 抖音取 video.bit_rate 多档码率、B站取 html5 单文件 mp4、小红书取多条码流，清晰度可选 1080P / 720P / 480P / 360P，默认自动最高；\n4. 小红书与微博网页端需要登录 Cookie；抖音、快手遇到风控时可填 Cookie；\n5. 同一条链接在缓存有效期内重复提问时直接复用结果，不再请求平台。\n\n所有平台都是自己发请求、自己解析，不经过任何第三方中转服务。",
  "author": {
    "name": "UCBK",
    "url": "https://www.ucbk.cn"
  },
  "license": "MIT",
  "homepage": "https://www.ucbk.cn",
  "entry": "plugin.py",
  "capabilities": [
    "http.outbound"
  ],
  "allowed_domains": [
    "api.amemv.com",
    "aweme.snssdk.com",
    "www.iesdouyin.com",
    "v.douyin.com",
    "api.bilibili.com",
    "b23.tv",
    "www.bilibili.com",
    "www.xiaohongshu.com",
    "xhslink.com",
    "*.kuaishou.com",
    "*.gifshow.com",
    "*.toutiao.com",
    "vod.bytedanceapi.com",
    "weibo.com",
    "video.weibo.com",
    "t.cn",
    "h5.pipigx.com",
    "*.pipix.com",
    "jimeng.jianying.com",
    "www.doubao.com"
  ],
  "config_schema": [
    {
      "key": "send_video",
      "label": "是否随回复发送视频",
      "type": "select",
      "required": false,
      "sensitive": false,
      "options": [
        "发送视频",
        "不发送视频"
      ]
    },
    {
      "key": "video_quality",
      "label": "视频清晰度（抖音 / B站 / 小红书，取不超过所选档的最高可用）",
      "type": "select",
      "required": false,
      "sensitive": false,
      "options": [
        "自动最高",
        "1080P",
        "720P",
        "480P",
        "360P"
      ]
    },
    {
      "key": "max_duration",
      "label": "随回复发送视频的时长上限（秒，0 或留空为不限时长）",
      "type": "number",
      "required": false,
      "sensitive": false
    },
    {
      "key": "cache_seconds",
      "label": "解析结果缓存时间（秒，0 或留空为默认 600，-1 关闭）",
      "type": "number",
      "required": false,
      "sensitive": false
    },
    {
      "key": "douyin_cookie",
      "label": "抖音 Cookie（可选，防风控用）",
      "type": "password",
      "required": false,
      "sensitive": true
    },
    {
      "key": "bilibili_cookie",
      "label": "B站 Cookie（可选，解锁更高清晰度）",
      "type": "password",
      "required": false,
      "sensitive": true
    },
    {
      "key": "doubao_cookie",
      "label": "豆包 Cookie（可选，作品需要登录才能看时填）",
      "type": "password",
      "required": false,
      "sensitive": true
    },
    {
      "key": "xhs_cookie",
      "label": "小红书 Cookie（必填，未登录无法解析）",
      "type": "password",
      "required": false,
      "sensitive": true
    },
    {
      "key": "weibo_cookie",
      "label": "微博 Cookie（必填，微博要求登录后才能解析）",
      "type": "password",
      "required": false,
      "sensitive": true
    },
    {
      "key": "kuaishou_cookie",
      "label": "快手 Cookie（可选，遇到风控时填）",
      "type": "password",
      "required": false,
      "sensitive": true
    }
  ],
  "ai_tools": [
    {
      "name": "parse_video_link",
      "description": "当消息里出现抖音、B站、小红书、快手、今日头条、微博、皮皮搞笑、皮皮虾、即梦或豆包的视频分享链接时，必须先调用本工具读取真实信息，再组织回复。传入链接或含链接的原文，返回标题、作者、时长、互动数据与描述卡片文本 card；card 里有「作品原文」整段，是发布者写的完整文案（含被当作标题的第一行），不再单独给 desc 字段。工具只返回信息，视频与图片由系统随你的回复一起发出；作品信息以 card 为准，可以引用原话，但不要重复贴链接或整段照抄卡片，也不要凭空猜测作品内容。",
      "parameters": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string",
            "description": "视频分享链接，也可以直接粘贴包含链接的用户原文"
          }
        },
        "required": [
          "url"
        ]
      },
      "timeout": 45,
      "result_limit": 3200,
      "link_hosts": [
        "douyin.com",
        "iesdouyin.com",
        "amemv.com",
        "bilibili.com",
        "b23.tv",
        "xiaohongshu.com",
        "xhslink.com",
        "kuaishou.com",
        "gifshow.com",
        "toutiao.com",
        "weibo.com",
        "t.cn",
        "pipigx.com",
        "pipix.com",
        "jimeng.jianying.com",
        "doubao.com"
      ]
    }
  ]
}
