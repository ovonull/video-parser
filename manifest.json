{
  "manifest_version": 1,
  "id": "cn.ucbk.video",
  "name": "视频解析",
  "version": "1.3.0",
  "description": "群里贴抖音、B站、小红书、快手、今日头条、微博、皮皮搞笑、皮皮虾、即梦、豆包链接，机器人先回一条描述卡片（标题、作者、时长、点赞等互动数据、作品简介），紧接着把视频发回群里；只有 QQ 拒收（体积过大、格式不支持）时才补一条无水印直链。默认不限时长。\n\n用法：\n1. 默认「粘贴链接即解析」，消息里带链接就会处理，不需要 @ 机器人；\n2. 也可以改成「仅指令触发」，此时要发「解析 + 链接」；\n3. 抖音图文作品发送全部原图（按每批 3 张分开发送），实况作品还会补发那段短视频；抖音取 video.bit_rate 多档码率、B站取 html5 单文件 mp4（自带音轨，无需 ffmpeg 合流）、小红书取多条码流，清晰度可在配置里选（1080P / 720P / 480P / 360P），默认自动最高；\n4. 抖音分享页前两次可能只回空壳页面，插件会自动重试三次；\n5. 小红书与微博网页端需登录 Cookie 才能解析（微博必填）；快手遇到风控时可填 Cookie；\n6. 抖音触发风控时，在插件配置里填抖音 Cookie 可显著提高成功率；B站 Cookie 用于解锁更高清晰度；\n7. 同一条链接在缓存有效期内重复粘贴时直接复用结果，不再请求平台。\n\n所有平台都是自己发请求、自己解析，不经过任何第三方中转服务。",
  "author": {
    "name": "UCBK",
    "url": "https://www.ucbk.cn"
  },
  "license": "MIT",
  "homepage": "https://www.ucbk.cn",
  "entry": "plugin.py",
  "capabilities": [
    "msg.send",
    "http.outbound"
  ],
  "allowed_domains": [
    "www.iesdouyin.com",
    "v.douyin.com",
    "m.douyin.com",
    "api.amemv.com",
    "aweme.snssdk.com",
    "api.bilibili.com",
    "b23.tv",
    "www.xiaohongshu.com",
    "xhslink.com",
    "sns-img-hw.xhscdn.com",
    "ci.xiaohongshu.com",
    "h5.pipigx.com",
    "file.ippzone.com",
    "jimeng.jianying.com",
    "www.doubao.com",
    "www.kuaishou.com",
    "kuaishou.com",
    "www.gifshow.com",
    "gifshow.com",
    "m.toutiao.com",
    "vod.bytedanceapi.com",
    "weibo.com",
    "video.weibo.com",
    "t.cn",
    "h5.pipix.com",
    "www.pipix.com",
    "m.pipix.com"
  ],
  "config_schema": [
    {
      "key": "reply_scope",
      "label": "生效范围",
      "type": "select",
      "required": false,
      "sensitive": false,
      "options": [
        "群聊与私聊",
        "仅群聊",
        "仅私聊"
      ]
    },
    {
      "key": "auto_parse",
      "label": "触发方式",
      "type": "select",
      "required": false,
      "sensitive": false,
      "options": [
        "粘贴链接即解析",
        "仅指令触发"
      ]
    },
    {
      "key": "trigger_words",
      "label": "指令触发词（英文逗号分隔，仅指令模式生效）",
      "type": "text",
      "required": false,
      "sensitive": false
    },
    {
      "key": "send_video",
      "label": "回复方式",
      "type": "select",
      "required": false,
      "sensitive": false,
      "options": [
        "发送视频",
        "只发链接"
      ]
    },
    {
      "key": "video_quality",
      "label": "视频清晰度（抖音 / B站 / 小红书，取不超过所选档的最高可用）",
      "type": "select",
      "required": false,
      "sensitive": false,
      "options": [
        "自动最高",
        "1080P",
        "720P",
        "480P",
        "360P"
      ]
    },
    {
      "key": "max_duration",
      "label": "直发视频的时长上限（秒，0 或留空为不限时长）",
      "type": "number",
      "required": false,
      "sensitive": false
    },
    {
      "key": "cooldown_seconds",
      "label": "同一链接重复解析冷却（秒，0 或留空为默认 15，-1 关闭）",
      "type": "number",
      "required": false,
      "sensitive": false
    },
    {
      "key": "cache_seconds",
      "label": "解析结果缓存时间（秒，0 或留空为默认 600，-1 关闭）",
      "type": "number",
      "required": false,
      "sensitive": false
    },
    {
      "key": "douyin_cookie",
      "label": "抖音 Cookie（可选，防风控用）",
      "type": "password",
      "required": false,
      "sensitive": true
    },
    {
      "key": "bilibili_cookie",
      "label": "B站 Cookie（可选，解锁更高清晰度）",
      "type": "password",
      "required": false,
      "sensitive": true
    },
    {
      "key": "doubao_cookie",
      "label": "豆包 Cookie（可选，作品需要登录才能看时填）",
      "type": "password",
      "required": false,
      "sensitive": true
    },
    {
      "key": "xhs_cookie",
      "label": "小红书 Cookie（必填，未登录无法解析）",
      "type": "password",
      "required": false,
      "sensitive": true
    },
    {
      "key": "weibo_cookie",
      "label": "微博 Cookie（必填，微博要求登录后才能解析）",
      "type": "password",
      "required": false,
      "sensitive": true
    },
    {
      "key": "kuaishou_cookie",
      "label": "快手 Cookie（可选，遇到风控时填）",
      "type": "password",
      "required": false,
      "sensitive": true
    }
  ]
}
